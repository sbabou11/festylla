# ─────────────────────────────────────────────────────────
# Fest'Ylla — Variables d'environnement Firebase
# ─────────────────────────────────────────────────────────
# 1. Copiez ce fichier en ".env.local" (jamais commité sur GitHub)
# 2. Remplacez chaque valeur par celles de votre projet Firebase
#    (console.firebase.google.com → Paramètres du projet → Vos applications)
# ─────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=votre-projet
VITE_FIREBASE_STORAGE_BUCKET=votre-projet.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
